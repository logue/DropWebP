{
  "name": "@drop-compress-image/app",
  "version": "2.3.0",
  "description": "Drop Image Compress desktop application built with Tauri, Vite, Vue 3, and TypeScript",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "clean": "rimraf ./node_modules/.vite",
    "build": "run-p type-check \"build-only {@}\" build:tauri --",
    "build:analyze": "vite build --mode analyze",
    "build:clean": "rimraf dist",
    "build:tauri": "tauri build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint && prettier src/**/*.{ts,vue} -w -u",
    "lint:style": "stylelint \"./src/**/*.{css,sass,scss,htm,html,vue}\" --fix --cache-location ./node_modules/.vite/vite-plugin-stylelint && prettier \"./src/**/*.{css,sass,scss,htm,html,vue}\" -w -u",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-http": "^2.5.4",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@vueuse/sound": "^2.1.3",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "unified-network": "0.6.4",
    "vue": "3.5.22",
    "vue-i18n": "^11.1.12",
    "vuetify": "3.10.7"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@tauri-apps/cli": "2.9.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "npm-run-all2": "^8.0.4",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass-embedded": "^1.93.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-checker": "0.11.0",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vite-plugin-vuetify": "^2.1.2",
    "vue-tsc": "^3.1.2"
  }
}