{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drop-compress-image",
  "mainBinaryName": "Drop Compress Image",
  "version": "3.0.1",
  "identifier": "dev.logue.drop-compress-image",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build-only",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Drop Compress Image",
        "width": 800,
        "height": 450,
        "minWidth": 800,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "publisher": "Logue",
    "active": true,
    "category": "GraphicsAndDesign",
    "shortDescription": "Drop Image Compress is a desktop application that converts images to WebP/Avif/JPEG XL format using drag-and-drop functionality.",
    "longDescription": "Drop Image Compress is a desktop application that converts images to WebP/Avif/JPEG XL format using drag-and-drop functionality. Built with Vite, Vue 3, TypeScript, and Tauri.",
    "targets": [
      "dmg",
      "msi",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleName": "Drop Compress Image"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true
      }
    }
  }
}