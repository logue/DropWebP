{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drop-compress-image",
  "mainBinaryName": "Drop Compress Image",
  "version": "3.2.1",
  "identifier": "dev.logue.drop-compress-image",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build-only",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Drop Compress Image",
        "width": 800,
        "height": 450,
        "minWidth": 800,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "publisher": "Logue",
    "active": true,
    "category": "GraphicsAndDesign",
    "shortDescription": "Drop Image Compress is a desktop application that converts images to WebP/Avif/JPEG XL/PNG/JPEG format using drag-and-drop functionality.",
    "longDescription": "Drop Image Compress is a desktop application that converts images to WebP/Avif/JPEG XL/PNG/JPEG format using drag-and-drop functionality. Built with Vite, Vue 3, TypeScript, and Tauri.",
    "targets": [
      "dmg",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleName": "Drop Compress Image",
      "minimumSystemVersion": "11.0",
      "entitlements": null,
      "exceptionDomain": null,
      "signingIdentity": null,
      "providerShortName": null,
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libheif-tools"
        ]
      },
      "rpm": {
        "depends": [
          "libheif-tools"
        ]
      }
    }
  }
}