{
  "name": "@drop-compress-image/frontend",
  "version": "3.4.1",
  "description": "A modern desktop application built with Tauri v2 and Vue 3",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "sync:env": "cd .. && node ./scripts/sync-env-config.mjs",
    "dev:tauri": "node ../scripts/run-tauri-dev.mjs",
    "clean": "rimraf ./node_modules/.vite",
    "build": "run-p type-check \"build-only {@}\" build:tauri --",
    "build:analyze": "vite build --mode analyze",
    "build:clean": "rimraf dist",
    "build:tauri": "node ../scripts/run-tauri-build.mjs",
    "build:tauri:mac": "node ../scripts/run-tauri-build.mjs --target universal-apple-darwin",
    "build:tauri:windows-x64": "node ../scripts/run-tauri-build.mjs --target x86_64-pc-windows-msvc",
    "build:tauri:windows-arm64": "node ../scripts/run-tauri-build.mjs --target aarch64-pc-windows-msvc",
    "build:tauri:windows-docker-x64": "cd .. && ./scripts/build-windows-docker.sh x64",
    "build:tauri:windows-docker-arm64": "cd .. && ./scripts/build-windows-docker.sh arm64",
    "build:tauri:linux-x64": "node ../scripts/run-tauri-build.mjs --target x86_64-unknown-linux-gnu",
    "build:tauri:linux-arm64": "node ../scripts/run-tauri-build.mjs --target aarch64-unknown-linux-gnu",
    "build:tauri:linux-docker-x64": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'pwsh ..\\\\scripts\\\\build-linux-docker.ps1 -Target x64' : 'bash ../scripts/build-linux-docker.sh x64', {stdio: 'inherit'})\"",
    "build:tauri:linux-docker-arm64": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'pwsh ..\\\\scripts\\\\build-linux-docker.ps1 -Target arm64' : 'bash ../scripts/build-linux-docker.sh arm64', {stdio: 'inherit'})\"",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache --cache-location ./node_modules/.vite/eslint-cache",
    "lint:prettier": "prettier \"./**/*.{js,ts,json,css,sass,scss,htm,html,vue,md}\" -w -u",
    "lint:style": "stylelint \"./**/*.{css,sass,scss,htm,html,vue}\" --fix --cache-location ./node_modules/.vite/stylelint-cache && prettier \"./**/*.{css,sass,scss,htm,html,vue}\" -w -u",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vueuse/sound": "^2.1.3",
    "core-js": "^3.49.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "unified-network": "^0.6.4",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.4",
    "vuetify": "^4.0.8"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.0",
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@tauri-apps/cli": "^2.11.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/markdown": "^8.0.2",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.1",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-oxlint": "^1.67.0",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-vue": "^10.9.1",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.6",
    "npm-run-all2": "^9.0.1",
    "oxlint": "^1.67.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.12.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-checker": "0.14.1",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vite-plugin-vuetify": "^2.1.3",
    "yaml-eslint-parser": "^2.0.0",
    "vue-tsc": "^3.3.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*": "run-s lint:*"
  }
}
